{
 "_meta": {
  "about": "Design notes that DRIVE pipeline/blender/gen_characters.py. Palette colours come from pipeline/extracted/cast.json (role names such as 'hair', 'shirt', 'accent', 'hat', 'hatk' resolve to them); anything here overrides. Every key is optional.",
  "schema": {
   "build": "sh (overall height, 1.0 = 1.5 m adult, children ~0.72), sw (shoulder / hip width), hs (head scale), bulk (limb thickness), belly, muscle (0..1), jaw, face_wide, stoop (old), sex ('m'|'f'), age ('child'|'teen'|'adult'|'old'), lift (sole height, 0 for barefoot -- automatic)",
   "face": "eyes (round|big|oval|tall|narrow|sharp|sleepy|dot|lash|lash_white|closed), iris, brows (none|thin|normal|thick|bushy) + brow_tilt (+ angry, - worried), mouth (smile|grin|flat|frown|open|o), nose (none|dot|small|normal|big|pointy), blush, freckles, glasses{type round|square|shades}, beard{type full|goatee|chin}, moustache{type thin|normal|bushy|handle}",
   "hair": "style (short|spiky|flat|long|bob|pony|twin|bun|loops|bald|tuft|long_pony|mohawk|none) + per-style knobs (len, spike_w, length, side, bun, bun_r ...)",
   "headwear": "type (cap|beanie|wide|sailor|chef|nurse|headband) + colours/logo",
   "top": "type (shirt|jacket|coat|dress|bare|robe) sleeves (none|short|three|long) collar (crew|polo|v|high|none) + colours / vest",
   "legs": "type (pants|baggy|gi|shorts|trunks|skirt|robe|none)",
   "shoes": "type (sneaker|boot|barefoot|heel|flat|loafer)",
   "gloves": "colour / cuff",
   "extras": "belt{balls}, tie, bowtie, scarf, necklace, backpack, cape, emblem, suspenders, wristbands"
  },
  "sources_general": [
   "Bulbapedia / Fandom / Wikipedia character pages (Red, Blue, Oak, Brock, Misty, Surge, Erika, Koga, Sabrina, Blaine, Giovanni, Lorelei, Bruno, Agatha, Lance, Bill, Mr. Fuji, Nurse Joy, Delia Ketchum, Daisy Oak)",
   "Bulbapedia trainer-class pages (Team Rocket Grunt, Scientist, Super Nerd, Biker, Hiker, Sailor, Fisher, Gambler, Channeler, Beauty, Bird Keeper, Cooltrainer)"
  ]
 },
